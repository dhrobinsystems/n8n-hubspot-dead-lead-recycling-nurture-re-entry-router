# --- Secrets & local environment ----------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*.json

# --- Local n8n data, SQLite and other databases ---------------------------------
.n8n/
n8n-data/
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.db
*.db-journal

# --- Simulator and sandbox outputs ----------------------------------------------
sim-output/
sandbox-output/
tmp/
temp/
*.tmp

# --- Exports (may contain CRM contact data or routing reports) ----------------
exports/
reports/
routing-exports/
*.csv
*.xlsx
routing-report*.json
enrichment-cache*.json

# --- Logs ----------------------------------------------------------------------------
*.log
logs/
npm-debug.log*

# --- Node / tooling ----------------------------------------------------------------
node_modules/
.npm/
coverage/

# --- OS / editor ---------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
