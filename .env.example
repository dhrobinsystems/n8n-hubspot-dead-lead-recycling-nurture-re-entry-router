# =============================================================================
# n8n-hubspot-dead-lead-recycling-nurture-re-entry-router :: environment template
# -----------------------------------------------------------------------------
# Copy to .env (git-ignored) or set in your n8n host / container / secret
# manager. Every value below is a PLACEHOLDER. Never commit real tokens.
#
# SAFE BY DEFAULT: leaving this file untouched keeps the workflow in
# SANDBOX_MODE: synthetic fixture, zero network calls, nothing written,
# nobody enrolled.
#
# Full text: DISCLAIMER.md · Licensed under the MIT License. License: MIT © 2026 dhRobin Systems · Provided as-is, see the disclaimer.
# =============================================================================

# ---- n8n runtime --------------------------------------------------------------
# Required so {{ $env.X }} works. If env access is blocked the workflow stays in
# sandbox mode instead of failing open.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=UTC

# ---- Safety switches (safe defaults shown) ----------------------------------
# Safe-ON: turn off only with an explicit false/0/no/off.
SANDBOX_MODE=true
DRY_RUN=true
# Safe-OFF: turn on only with an explicit true/1/yes/on.
# Stamps recycle_* properties on contacts (required by the two routing switches below).
HUBSPOT_WRITES_ENABLED=false
# Enrolls outbound-qualified contacts in HubSpot sequences.
SEQUENCE_ENROLLMENT_ENABLED=false
# Marks nurture contacts (recycle_route=NURTURE) and adds them to NURTURE_LIST_ID.
NURTURE_ROUTING_ENABLED=false
# Calls the enrichment provider (spends credits; allowed in a live dry run too).
ENRICHMENT_ENABLED=false

# ---- HubSpot --------------------------------------------------------------------
HUBSPOT_PRIVATE_APP_TOKEN=your_hubspot_private_app_token_here
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_ALLOWED_HOSTS=api.hubapi.com,api-eu1.hubapi.com
HUBSPOT_SEARCH_PAGE_SIZE=200

# ---- Cooling-off window ------------------------------------------------------------
# Days since the LATEST touch (lost date, disqualified date, last contact, last sales
# activity, last reply, last recycle) before a contact may re-enter.
COOLING_OFF_DAYS=120
# How far back (beyond the cooling-off cutoff) closed-lost deals are searched.
LOOKBACK_DAYS=730
# Minimum days between two verifications of the same contact (saves enrichment credits).
REEVALUATION_INTERVAL_DAYS=30
# Lifetime cap on recycles per contact.
MAX_RECYCLES=2

# ---- Population --------------------------------------------------------------------
# Deal stage internal ids counted as closed-lost (comma-separated; "none" disables).
CLOSED_LOST_STAGES=closedlost
# hs_lead_status values counted as disqualified ("none" disables).
DISQUALIFIED_LEAD_STATUSES=UNQUALIFIED,BAD_TIMING
# Contact date property holding the disqualification date (custom; see README).
DISQUALIFIED_DATE_PROPERTY=recycle_disqualified_at
# Lifecycle stages that are never recycled ("none" disables).
EXCLUDE_LIFECYCLE_STAGES=customer,evangelist

# ---- Qualification rules (case-insensitive regex; "none" disables) ------------------
EXCLUDE_LOST_REASONS_REGEX=\b(do not contact|legal|fraud|spam|bankrupt|out of business)\b
NURTURE_ONLY_LOST_REASONS_REGEX=\b(competitor|went with|chose|signed with|multi-year)\b
OUTBOUND_TITLE_REGEX=\b(chief|c[eotfmr]o|vp|vice president|head of|director|founder|co-founder|owner|president|partner)\b
TARGET_TITLE_REGEX=\b(manager|lead|director|head|vp|chief|c[eotfmr]o|founder|owner|president|partner|specialist|architect|engineer)\b
EXCLUDE_TITLE_REGEX=\b(student|intern|retired|unemployed|freelance|job seeker)\b
# Outbound only to re-verified VALID emails (false also allows HubSpot-clean UNVERIFIED).
REQUIRE_VERIFIED_EMAIL_FOR_OUTBOUND=true
# Allow RISKY / UNKNOWN (catch-all) emails into nurture.
NURTURE_ALLOW_RISKY=false
# Overwrite jobtitle with the re-verified title.
UPDATE_JOB_TITLE=false
# hs_lead_status to set when a contact is routed (empty = leave unchanged), e.g. OPEN.
SET_LEAD_STATUS_ON_ROUTE=

# ---- Enrichment / verification adapter (provider-agnostic) --------------------------
# none = HubSpot bounce / opt-out signals only; http = call ENRICHMENT_API_URL.
ENRICHMENT_MODE=none
ENRICHMENT_API_KEY=your_enrichment_api_key_here
# POST endpoint receiving {email, firstName, lastName, company, jobTitle}. No query strings.
ENRICHMENT_API_URL=https://enrichment.example.com/v1/verify
ENRICHMENT_ALLOWED_HOSTS=enrichment.example.com
ENRICHMENT_AUTH_HEADER=Authorization
# Prefix for the key in the auth header; "none" for a bare key (e.g. with X-API-Key).
ENRICHMENT_AUTH_PREFIX=Bearer
# Dotted paths into the provider response.
ENRICHMENT_RESPONSE_MAP_JSON={"emailStatus":"email_status","jobTitle":"job_title","company":"company","stillAtCompany":"still_at_company"}
# Provider status -> VALID / INVALID / RISKY / UNKNOWN (merged with built-in defaults).
ENRICHMENT_EMAIL_STATUS_MAP_JSON={}
# Send first / last name to the provider (false = email, company and title only).
ENRICHMENT_SEND_NAME=true
ENRICHMENT_TIMEOUT_MS=15000
ENRICHMENT_MAX_PER_RUN=200

# ---- Re-entry targets (placeholder ids; replace with your own) ------------------------
# Sequence per source.
SEQUENCE_MAP_JSON={"CLOSED_LOST":"10000001","DISQUALIFIED":"10000002"}
# Contact owner id -> sequence sender (HubSpot user id + connected inbox).
OWNER_SENDER_MAP_JSON={"20000001":{"userId":"30000001","senderEmail":"rep.one@example.com"}}
# Fallback sender for unowned contacts or owners without a mapping (both or neither).
DEFAULT_SENDER_USER_ID=
DEFAULT_SENDER_EMAIL=
# Static (manual) list for nurture re-entry; a HubSpot workflow can enroll from it.
NURTURE_LIST_ID=

# ---- Caps per run ------------------------------------------------------------------------
MAX_OUTBOUND_PER_RUN=50
MAX_OUTBOUND_PER_OWNER=15
MAX_NURTURE_PER_RUN=500

# ---- Testing ------------------------------------------------------------------------------
# Pins "now" (ISO 8601) for reproducible runs.
NOW_OVERRIDE=

